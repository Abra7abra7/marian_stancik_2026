{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/posts/:slug",
      "destination": "/blog/posts/:slug",
      "permanent": true
    },
    {
      "source": "/posts/:slug.html",
      "destination": "/blog/posts/:slug",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(favicon.*|apple-touch-icon.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
    {
      "source": "/(favicon.*|apple-touch-icon.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
        { "key": "Link", "value": "</llms.txt>; rel=\"describedby\", </llms-full.txt>; rel=\"describedby\"" }
      ]
    },
    {
      "source": "/css/(.*)",
      "headers": [
    {
      "source": "/(favicon.*|apple-touch-icon.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
    {
      "source": "/(favicon.*|apple-touch-icon.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)\\.(webp|jpg|jpeg|png|svg|ico|mp4|webm|woff2|woff)",
      "headers": [
    {
      "source": "/(favicon.*|apple-touch-icon.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(llms\\.txt|llms-full\\.txt|robots\\.txt|sitemap\\.xml|rss\\.xml|blog/posts\\.json)",
      "headers": [
    {
      "source": "/(favicon.*|apple-touch-icon.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
        { "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
    {
      "source": "/(favicon.*|apple-touch-icon.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
        { "key": "Link", "value": "</index.html.md>; rel=\"alternate\"; type=\"text/markdown\"" }
      ]
    },
    {
      "source": "/blog/index.html",
      "headers": [
    {
      "source": "/(favicon.*|apple-touch-icon.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
        { "key": "Link", "value": "</blog/index.html.md>; rel=\"alternate\"; type=\"text/markdown\"" }
      ]
    },
    {
      "source": "/blog/posts/(.*)",
      "headers": [
    {
      "source": "/(favicon.*|apple-touch-icon.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
        { "key": "Link", "value": "</blog/posts/$1.md>; rel=\"alternate\"; type=\"text/markdown\"" }
      ]
    }
  ]
}